# Copy to .env and adjust as needed.

# Lightweight model pulled into Ollama on first startup. Swap for anything
# in https://ollama.com/library — smaller = faster on CPU-only machines.
OLLAMA_MODEL=qwen2.5:1.5b

# Grafana admin login (observability profile only; localhost-only, fine to leave as default for local dev).
GRAFANA_ADMIN_PASSWORD=admin

# Host-side port overrides — only needed if the defaults below already
# collide with something else running on your machine.
# OLLAMA_HOST_PORT=11434
# RAG_APP_HOST_PORT=8001
# OPEN_WEBUI_HOST_PORT=8080
